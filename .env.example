PORT=3003

# Internal services
POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

# Datastores
MONGODB_URI=mongodb://mongo.digitalinsurance.dev:27017/claims
REDIS_URL=redis://redis.digitalinsurance.dev:6379

# Claim document storage
AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

# OpenAI — claim triage (gpt-4o-mini) and policy wording embeddings
# (text-embedding-3-small).
# OPENAI_BASE_URL is the only switch needed to route this service's OpenAI
# traffic through the APISynQ AI gateway; set it to
# https://governance-api.apisynq.com/v1/ai-gw/openai/v1
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — claim document extraction (claude-sonnet-4-5)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Pinecone — policy wording vector index used by the triage agent
PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
PINECONE_NAMESPACE=policy-wording-v1
