PORT=3003

# Internal services
POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

# Datastores
MONGODB_URI=mongodb://mongo.digitalinsurance.dev:27017/claims
REDIS_URL=redis://redis.digitalinsurance.dev:6379

# Claim document storage
AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

# OpenAI — claim triage (gpt-4o-mini) and policy wording embeddings
# (text-embedding-3-small).
# OPENAI_BASE_URL is the only switch needed to route this service's OpenAI
# traffic through the APISynQ AI gateway; set it to
# https://governance-api.apisynq.com/v1/ai-gw/openai/v1
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — claim document extraction (claude-sonnet-4-5)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Pinecone — policy wording vector index used by the triage agent
#
# PRODUCTION — use your production Pinecone project's API key.
PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
# PINECONE_NAMESPACE_ALIAS is a namespace alias managed in the Pinecone control
# plane. It points to the current physical namespace (e.g. policy-wording-v1).
# To hot-swap to a newly indexed namespace, repoint the alias via the Pinecone
# Aliases API — no code change or service restart required.
PINECONE_NAMESPACE_ALIAS=policy-wording-current

# DEVELOPMENT / TEST — use a *separate* Pinecone project so that test vectors
# never reach the production index. Pinecone Local (the Docker emulator) is EOL
# and will be removed on 2026-10-07; create a dedicated non-production project
# in your Pinecone account instead (free Starter tier is sufficient).
# Set PINECONE_API_KEY to PINECONE_API_KEY_DEV in your local .env to point the
# service at the dev project.
PINECONE_API_KEY_DEV=pcsk-REPLACE_ME_DEV
PINECONE_INDEX_DEV=policy-wording-dev
PINECONE_NAMESPACE_ALIAS_DEV=policy-wording-current
