PORT=3003

POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

MONGODB_URI=mongodb://mongo.digitalinsurance.dev:27017/claims
# Use rediss:// (TLS) for all non-localhost Redis connections to protect
# cached PII and lock keys in transit.  Replace the placeholder credentials
# and hostname as appropriate for your environment.
REDIS_URL=rediss://redis.digitalinsurance.dev:6379

# AES-256-GCM key used to encrypt cached triage results at the application
# layer before writing to Redis.  Must be exactly 64 hex characters (32 bytes).
# Generate a fresh key with:  openssl rand -hex 32
REDIS_CACHE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
PINECONE_NAMESPACE=policy-wording-v1
