PORT=3003

POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

# MongoDB Atlas connection string.
# Supply tls, authSource, retryWrites, and w options; inject via secret manager at runtime.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/claims?tls=true&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/claims?tls=true&authSource=admin&retryWrites=true&w=majority
REDIS_URL=redis://redis.digitalinsurance.dev:6379

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
PINECONE_NAMESPACE=policy-wording-v1
