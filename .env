PORT=3003

POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

MONGODB_URI=mongodb://mongo.digitalinsurance.dev:27017/claims
REDIS_URL=rediss://:REPLACE_REDIS_PASSWORD@redis.digitalinsurance.dev:6380

# 64-character hex string (32 random bytes) used to AES-256-GCM-encrypt
# triage results before they are written to Redis.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
PINECONE_NAMESPACE=policy-wording-v1
