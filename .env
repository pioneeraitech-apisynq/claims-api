PORT=3003

POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

# Supply credentials via your secrets manager; never commit real values here.
# mongodb+srv:// enables TLS by default.  Add &authSource=admin if your Atlas
# cluster requires it.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@mongo.digitalinsurance.dev/claims?retryWrites=true&w=majority
REDIS_URL=redis://redis.digitalinsurance.dev:6379

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# MongoDB Atlas Vector Search is now used for policy-wording retrieval.
# The PINECONE_* variables below are no longer required and can be removed
# once the Atlas vector index has been created.
# PINECONE_API_KEY=pcsk-REPLACE_ME
# PINECONE_INDEX=policy-wording
# PINECONE_NAMESPACE=policy-wording-v1
