MONGODB_URI=mongodb://mongo.digitalinsurance.dev:27017/claims
REDIS_URL=redis://redis.digitalinsurance.dev:6379

# Application-layer encryption for Redis-cached triage data (AES-256-GCM).
# Replace with the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_CACHE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

PINECONE_API_KEY=pcsk-REPLACE_ME
