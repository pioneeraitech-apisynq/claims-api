PORT=3003

POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

MONGODB_URI=mongodb+srv://mongo.digitalinsurance.dev/claims?tls=true&tlsAllowInvalidCertificates=false
REDIS_URL=redis://redis.digitalinsurance.dev:6379

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
PINECONE_NAMESPACE=policy-wording-v1

# AES-256-GCM key (32 random bytes, hex-encoded) used for field-level
# encryption of sensitive PII/health fields (medicalNotes, dateOfBirth,
# claimantEmail).  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY
