PORT=3003

POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev

MONGODB_URI=mongodb://mongo.digitalinsurance.dev:27017/claims
# Use rediss:// (TLS) in production. Inject the real URL at deploy time via
# your secrets manager — never commit credentials to version control.
REDIS_URL=REPLACE_ME

# 32-byte (or longer) random secret used to AES-256-GCM-encrypt cached triage
# data at rest in Redis.  Generate with: openssl rand -hex 32
REDIS_ENCRYPTION_KEY=REPLACE_ME

AWS_REGION=us-east-1
CLAIM_DOCUMENTS_BUCKET=digital-insurance-claim-docs

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

PINECONE_API_KEY=pcsk-REPLACE_ME
PINECONE_INDEX=policy-wording
PINECONE_NAMESPACE=policy-wording-v1
